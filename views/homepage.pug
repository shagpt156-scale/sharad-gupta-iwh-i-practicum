doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        h1 Custom Object Records
        a(href="/update-cobj") Add to this table
        table
            thead
                tr
                    th Name
                    th Bio
                    th Category
            tbody
                each record in data
                    tr
                        td= record.properties.name
                        td= record.properties.bio
                        td= record.properties.category
